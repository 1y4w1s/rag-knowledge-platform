{
  "protocol": "w9_critic_capability_contract_v1",
  "base_sha": "33e7c551081eaa22db2eb5c7f9fec1f0585f4976",
  "state": "PARTIAL",
  "capability_valid_denominator": 12,
  "identity_scheme": "sha256 of the stable case-scoped claim key; exact claim text remains an independently compared field",
  "verdicts": {
    "existing_critic_present": "YES",
    "w9_semantic_claim_critic_capability": "PARTIAL",
    "duplicate_reflection_risk": "HIGH",
    "deterministic_layer_defined": "YES",
    "semantic_layer_defined": "YES",
    "ready_for_product_experiment": "NO",
    "ready_for_real_local_measurement": "NO",
    "runtime_rollout": "NO"
  },
  "report_contract": {
    "finding_statuses": [
      "SUPPORTED",
      "UNSUPPORTED",
      "CONFLICTED",
      "INSUFFICIENT_EVIDENCE",
      "UNVERIFIABLE"
    ],
    "evaluation_states": ["JUDGED", "BLOCKED_BY_DETERMINISTIC"],
    "decision_owners": ["DETERMINISTIC", "SEMANTIC"],
    "recommended_actions": [
      "ACCEPT",
      "REVISE_FROM_EXISTING_EVIDENCE",
      "RETRIEVE_MISSING_EVIDENCE",
      "CLARIFY",
      "REFUSE"
    ],
    "critic_is_advisory_only": true,
    "claim_identity_is_case_scoped": true,
    "semantic_status_is_null_when_blocked": true,
    "reason_code_is_required": true,
    "no_chain_of_thought": true
  },
  "evidence_discipline": {
    "allowed_input": [
      "current run query",
      "fully buffered final draft after all content mutations",
      "AgentGenerationPlan.gated_chunks",
      "citations synchronized to those gated chunks",
      "optional read-only EvidenceState metadata from the same run"
    ],
    "forbidden_input_or_action": [
      "oracle labels or expected actions",
      "self-querying the database",
      "expanding workspace or kb scope",
      "silent web retrieval",
      "memory as factual authority",
      "executing retrieve, revise, clarify, refuse, or accept"
    ],
    "scope_rule": "Every evidence reference must resolve to the frozen prompt-visible evidence snapshot for the same run, workspace, and allowed knowledge base."
  },
  "layer_ownership": {
    "deterministic_first": [
      "citation syntax",
      "citation identifier existence",
      "evidence provenance and workspace/kb/run scope",
      "missing citation on a factual claim",
      "known structured conflict",
      "known required fact missing"
    ],
    "semantic_only": [
      "claim detection after non-assertive span exclusion",
      "claim-to-evidence entailment",
      "semantic contradiction not already represented structurally",
      "unsupported or unverifiable factual assertion"
    ],
    "explicit_non_rule": "Shallow lexical overlap is a heuristic semantic signal, not deterministic proof of support.",
    "degraded_rule": "Missing model access, invalid structured output, timeout, or exception is UNVERIFIABLE/degraded, never a semantic pass."
  },
  "stage_order": [
    "fixture_contract_valid",
    "report_schema_valid",
    "claim_detection_valid",
    "evidence_scope_valid",
    "deterministic_layer_valid",
    "semantic_critic_valid",
    "report_aggregation_valid",
    "action_recommendation_valid",
    "advisory_budget_valid"
  ],
  "failure_taxonomy": [
    "INVALID_FIXTURE_CONTRACT",
    "REPORT_SCHEMA_INVALID",
    "CLAIM_DETECTION_MISS",
    "CLAIM_DETECTION_FALSE_POSITIVE",
    "CLAIM_IDENTITY_MISMATCH",
    "EVIDENCE_REF_INVALID",
    "EVIDENCE_OUT_OF_SCOPE",
    "EVIDENCE_FABRICATED",
    "MEMORY_AS_AUTHORITY",
    "CITATION_SYNTAX_INVALID",
    "CITATION_ID_INVALID",
    "MISSING_CITATION_MISSED",
    "KNOWN_CONFLICT_MISSED",
    "REQUIRED_FACT_MISSING_MISSED",
    "DETERMINISTIC_DELEGATION_VIOLATION",
    "SUPPORTED_FALSE_ALARM",
    "UNSUPPORTED_MISSED",
    "CONFLICT_STATUS_MISSED",
    "INSUFFICIENT_STATUS_MISSED",
    "UNVERIFIABLE_STATUS_MISSED",
    "REPORT_COUNT_MISMATCH",
    "CRITIC_PASS_MISMATCH",
    "UNSAFE_ACCEPT",
    "UNNECESSARY_REVISE",
    "UNNECESSARY_RETRIEVE",
    "WRONG_ACTION",
    "CRITIC_EXECUTED_ACTION",
    "CRITIC_BUDGET_EXCEEDED",
    "HIDDEN_RETRY_AMPLIFICATION",
    "NONE"
  ],
  "metrics": {
    "aggregation": "No weighted aggregate is allowed; every metric reports numerator, denominator, rate, and N/A reason.",
    "claim_metrics": [
      "claim_detection_precision",
      "claim_detection_recall",
      "nonassertive_exclusion_rate",
      "supported_claim_precision",
      "supported_claim_recall",
      "unsupported_claim_recall",
      "conflict_detection",
      "insufficient_detection",
      "unverifiable_detection",
      "false_critic_alarm",
      "missed_unsupported_claim"
    ],
    "action_metrics": [
      "action_recommendation_correct",
      "safe_accept_precision",
      "safe_accept_rate",
      "necessary_accept_rate",
      "unsafe_accept_rate",
      "unnecessary_intervention_rate",
      "unnecessary_retrieve_rate"
    ],
    "zero_tolerance_counts": [
      "evidence_scope_violation_count",
      "semantic_called_on_deterministic_block_count",
      "critic_action_execution_count",
      "retry_amplification_count"
    ]
  },
  "hard_negative_controls": {
    "controls_are_evaluator_sanity_only": true,
    "controls_are_not_in_capability_denominator": true,
    "uniform_policy_maximum_action_accuracy": {
      "ALWAYS_ACCEPT": "5/12",
      "ALWAYS_REVISE": "3/12",
      "ALWAYS_RETRIEVE": "2/12",
      "ALWAYS_CLARIFY": "1/12",
      "ALWAYS_REFUSE": "1/12"
    },
    "pass_rule": "Every uniform policy must fail at least one hard gate; unsafe accept, unnecessary intervention, and zero-prediction semantic degeneracy cannot be hidden by an aggregate score."
  },
  "local_model_protocol": {
    "future_model": "zai-org/glm-4.6v-flash",
    "thinking": "OFF",
    "output": "short structured JSON only",
    "p0_execution": "NOT_RUN",
    "lm_studio": "PROHIBITED_IN_P0"
  },
