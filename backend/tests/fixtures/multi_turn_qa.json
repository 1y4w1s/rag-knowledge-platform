      "thread": [
        {"role": "user", "content": "试用期离职要提前多久通知？"},
        {"role": "assistant", "content": "试用期员工提前3天通知即可。"},
        {"role": "user", "content": "正式员工呢？"}
      ],
      "query": "正式员工离职需要提前多久通知",
