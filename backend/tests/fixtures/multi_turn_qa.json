    },
    {
      "case_id": "MT-12",
      "domain": "resignation",
      "thread": [
        {"role": "user", "content": "竞业限制期是多久？"},
        {"role": "assistant", "content": "高管及核心技术人员的竞业限制期为离职后12个月。"},
        {"role": "user", "content": "这期间有补偿吗？"}
