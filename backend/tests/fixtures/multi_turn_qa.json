{
  "version": "1.0",
  "description": "multi_turn_qa v1.0 - 18 multi-turn dialogue groups for testing query rewriting. Each case contains a thread (user-assistant turns) and a rewritten query that resolves anaphora/ellipsis. Retrieval is measured against the rewritten query under plus_multi_turn configuration.",
  "cases": [
    {
      "case_id": "MT-1",
      "domain": "attendance",
      "thread": [
        {"role": "user", "content": "年假有多少天？"},
        {"role": "assistant", "content": "员工工作满一年后每年有10天年假。"},
        {"role": "user", "content": "那病假呢？"}
      ],
      "query": "病假有多少天",
      "source": "md",
      "expect": {
        "section_title": "1.3 事假与病假",
        "heading_path_contains": "考勤制度",
        "content_contains": "病假全年累计不超过 30 天"
      }
    },
    {
      "case_id": "MT-2",
      "domain": "attendance",
      "thread": [
        {"role": "user", "content": "迟到怎么处理？"},
        {"role": "assistant", "content": "迟到30分钟以内按事假半天处理，超过30分钟按旷工处理。"},
        {"role": "user", "content": "那旷工的后果是什么？"}
      ],
      "query": "旷工的后果是什么",
      "source": "md",
      "expect": {
        "section_title": "1.2 迟到",
        "heading_path_contains": "考勤制度",
        "content_contains": "旷工"
      }
    },
    {
      "case_id": "MT-3",
      "domain": "attendance",
      "thread": [
        {"role": "user", "content": "事假能请多少天？"},
        {"role": "assistant", "content": "事假全年累计不得超过15天，须提前一天申请。"},
        {"role": "user", "content": "请假期间有工资吗？"}
      ],
      "query": "事假期间有工资吗",
      "source": "md",
      "expect": {
        "section_title": "1.3 事假与病假",
        "heading_path_contains": "考勤制度",
        "content_contains": "事假期间无薪"
      }
    },
    {
      "case_id": "MT-4",
      "domain": "salary",
      "thread": [
        {"role": "user", "content": "年终奖什么时候发？"},
        {"role": "assistant", "content": "年终奖于每年12月发放，发放日前需仍在职。"},
        {"role": "user", "content": "发放条件是什么？"}
      ],
      "query": "年终奖的发放条件是什么",
      "source": "md",
      "expect": {
        "section_title": "2.1 年终奖",
        "heading_path_contains": "薪酬福利",
        "content_contains": "发放日"
      }
    },
    {
      "case_id": "MT-5",
      "domain": "salary",
      "thread": [
        {"role": "user", "content": "餐补每个月多少？"},
        {"role": "assistant", "content": "正式员工每月餐补300元，随工资发放。"},
        {"role": "user", "content": "销售岗位的通讯补贴呢？"}
      ],
      "query": "销售岗位的通讯补贴是多少",
      "source": "md",
      "expect": {
        "section_title": "2.3 通讯补贴",
        "heading_path_contains": "薪酬福利",
        "content_contains": "销售岗位 200 元"
      }
    },
    {
      "case_id": "MT-6",
      "domain": "salary",
      "thread": [
        {"role": "user", "content": "餐补标准是多少？"},
        {"role": "assistant", "content": "正式员工每月餐补300元。"},
        {"role": "user", "content": "这个补贴是所有岗位都一样吗？"}
      ],
      "query": "餐补是否所有岗位都一样",
      "source": "md",
      "expect": {
        "section_title": "2.2 餐补",
        "heading_path_contains": "薪酬福利",
        "content_contains": "正式员工"
      }
    },
    {
      "case_id": "MT-7",
      "domain": "overtime",
      "thread": [
        {"role": "user", "content": "工作日加班怎么算？"},
        {"role": "assistant", "content": "工作日加班按基本工资1.5倍计算加班费。"},
        {"role": "user", "content": "那周末和法定节假日呢？"}
