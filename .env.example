# 索隐（Suoyin / 代码目录 rag-knowledge-platform）— 环境变量模板
# 用法：复制为 .env 并填入真实值（.env 已在 .gitignore，不会进 Git）
# Canonical 开发/演示栈：docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# --- 数据库（Docker compose 默认）---
# 模板占位 changeme：复制为 .env 后必须改强密（建议 ≥16 位随机）。
# 卷策略（NW-11）：POSTGRES_PASSWORD 仅在「空卷首次初始化」时写入库内密码。
# 已有 postgres_data 卷时：只改 .env 不会自动改库密 → 须对运行中库 ALTER USER
# 并与 compose 插值的 DATABASE_URL 对齐，或删卷重建（会清空数据，须先备份）。
POSTGRES_PASSWORD=changeme
# api 容器内由 docker-compose.yml 覆盖为 postgres 主机名；本机 venv 连 Docker 库时用 localhost 这行：
DATABASE_URL=postgresql+asyncpg://ruige:changeme@localhost:5432/ruige

# --- 鉴权 ---
# 必须换成 ≥32 字符随机串。下列字面量会被启动守卫拒绝：
#   changeme · replace-with-a-long-random-string
# 建议：openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# --- Webhook 回调安全 ---
# P1-S2：webhook secret 的 at-rest 加密专用密钥（独立管理，禁止与 JWT_SECRET 相同）
WEBHOOK_ENCRYPTION_SECRET=

# --- 监控（Prometheus scrape）---
# /metrics 静态令牌；未配置则端点 fail-closed 401，Prometheus 抓取无数据（面板/告警 NoData）
METRICS_BEARER_TOKEN=
# Grafana 管理密码（T6-DC-2 弱口令守卫）：本地开发可填任意强口令，生产必须 ≥32 位随机字符
GRAFANA_PASSWORD=change-me-strong-password

# --- LLM / 嵌入 API（仅服务端读取，前端永不接触）---
# 对话生成：CHAT_PROVIDER=deepseek|tongyi（默认 deepseek；通义复用 TONGYI_API_KEY）
CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
TONGYI_API_KEY=
# TONGYI_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TONGYI_CHAT_MODEL=qwen-plus
# 嵌入：默认 bge = BGE-small-zh 本地 ONNX（零云依赖，无需 Key）；tongyi 为可切换备选（须配 TONGYI_API_KEY）
EMBEDDING_PROVIDER=bge
# EMBEDDING_MODEL=text-embedding-v2   # 仅当 EMBEDDING_PROVIDER=tongyi 时生效
# 运维全库重嵌 API（空=禁用 POST /api/v1/internal/re-embed）
RE_EMBED_TOKEN=
# H2 orphan 扫描（空=禁用 POST /api/v1/internal/orphan-scan；CLI 不依赖）
ORPHAN_SCAN_TOKEN=
# ORPHAN_GRACE_HOURS=24
# ORPHAN_MAX_DELETE=100
# H3 回收站保留天数 / 单次 purge 上限（CLI scripts/purge_trash.py）
# TRASH_RETENTION_DAYS=30
# TRASH_PURGE_MAX_DELETE=100
# NW-20 对话保留期（天；0=禁用；CLI scripts/purge_chat_threads.py；默认干跑）
# CHAT_RETENTION_DAYS=0
# CHAT_PURGE_MAX_DELETE=100
# NW-12 超龄入库对账（CLI scripts/scan_stale_ingestion.py；默认干跑；不上 Beat）
# INGEST_STALE_QUEUED_MINUTES=60
# INGEST_STALE_PROCESSING_MINUTES=120
# INGEST_STALE_MAX_APPLY=100

# --- 检索融合 / 拒答（A4：对着 Enterprise 掉分题复核后再改）---
# RRF_K=60
# RRF_VECTOR_WEIGHT=1.0
RRF_FTS_WEIGHT=1.5
# RETRIEVAL_MIN_TOP1_SIMILARITY=0.35
# RELEVANCE_SIMILARITY_FALLBACK=0.45
# RELEVANCE_GREY_ANCHOR_LO=0.65
# M1 候选②：低置信度标记阈值（confidence_reply 与 generation 统一读此配置）
# RELEVANCE_LOW_SIM_CEILING=0.5

# --- 送模上下文预算（M1 候选①：本地小模型长上下文利用弱，超预算丢低分片段尾部）---
# 0=不启用（默认）；启用示例：16000（字符）
# LLM_CONTEXT_BUDGET_CHARS=0

# --- 熔断器（本地评测须调高，防 json_object 400 打爆熔断器）---
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=1000

# --- 缓存（检索 chunk + LLM 响应）---
# 检索 chunk 缓存 TTL（秒）；本进程内 LRU 上限 5000 条
# QUERY_CACHE_TTL_SECONDS=300
# QUERY_CACHE_MAX_SIZE=5000
# LLM 响应缓存 TTL（秒）；0=关闭缓存（完全相同的 messages 才命中）
# LLM_RESPONSE_CACHE_TTL_SECONDS=600

# --- 检索 rerank（A2：BGE ONNX 真路径；默认关，开前建议 diagnose --rerank）---
RERANK_ENABLED=false
# off=默认 RRF；always=旧开精排+高置信跳过；conditional=仅排序歧义时精排
RERANK_POLICY=off
RERANK_PROVIDER=bge
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_INPUT_TOP_N=20
# BGE_RERANK_CACHE_DIR=

# --- A1 多 query（默认单问；conditional=短问/miss 才扩；勿默认 always）---
QUERY_REWRITE_ENABLED=false
# off=默认单问；always=旧开多 query；conditional=短问或首轮池空洞才扩
QUERY_REWRITE_POLICY=off
# QUERY_REWRITE_MAX_VARIANTS=3
# QUERY_REWRITE_VARIANT_WEIGHT=0.7

# --- Celery 异步入库（G1）---
# 本机 venv / pytest：保持默认 true（BackgroundTasks，无需 Redis）
# 全栈 docker compose 会覆盖为 false（真 worker）
# 注意：正确变量名是 CELERY_TASK_ALWAYS_EAGER_LOCAL（带 _LOCAL）
# CELERY_TASK_ALWAYS_EAGER_LOCAL=true
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Redis 跨副本限流（G2）---
# 代码默认 redis；本机 venv / pytest 请显式设 memory（无需 Redis）
# 全栈 compose 显式设 RATE_LIMIT_BACKEND=redis；限流用 REDIS_URL DB1，Celery 用 /0
# REDIS_URL=redis://localhost:6379/1
# RATE_LIMIT_BACKEND=memory
# 回滚：RATE_LIMIT_BACKEND=memory 并重启 api

# --- 文件存储 ---
UPLOAD_DIR=./uploads
# 单文件上限（字节）；默认 20MB
# UPLOAD_MAX_BYTES=20971520
# NW-25 单库总容量硬闸（字节；含 trash + 版本；非计费）。默认 10GiB；0=关闭总闸
# KB_QUOTA_MAX_BYTES=10737418240

# --- 引用 excerpt 脱敏（NW-27：手机号/证件/邮箱→占位；先 mask 后截断；默认开）---
# CITATION_REDACT_ENABLED=true
# 演示要看真号：CITATION_REDACT_ENABLED=false 并重启 api（不 scrub LLM/预览）
# NW-34：送模【检索片段】正则减敏（P2-R16 默认开；关后号码/邮箱题可能答错；仍算出境 ≠ NW-33）
# LLM_CONTEXT_REDACT_ENABLED=true

# --- PDF 文字层版式降噪（B1：页眉/页脚重复行；默认开，可关回退）---
# PDF_LAYOUT_DENOISE_ENABLED=true

# --- 大表 / 跨页表格（B2：行窗切分 + PDF 同表合并；默认开，可关≈F3 旧行为）---
# TABLE_CHUNK_SPLIT_ENABLED=true
# TABLE_PARENT_MAX_CHARS=8000
# TABLE_ROW_OVERLAP=1

# --- 前端跨域（Wave 4 本地 Vite 默认 5173）---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
