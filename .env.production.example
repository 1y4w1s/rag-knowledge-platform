# 索隐 — 生产环境变量模板
# 用法：
#   1. 复制为 .env（生产加固场景；日常 Compose 演示优先用 .env.example）
#   2. 填入真实密钥（所有 `changeme` / 禁字面量必须替换）
#   3. 执行 chmod 600 .env（Unix）或 icacls .env /inheritance:r /grant "%USERNAME%:F"（Windows）
#   4. 确保 .env 在 .gitignore 中（已在）
#
# 安全要求（甲方 IT 审计）：
#   ✅ POSTGRES_PASSWORD / GRAFANA_PASSWORD / JWT_SECRET 必须 ≥ 32 位随机字符
#   ✅ JWT_SECRET 禁止字面量：changeme · replace-with-a-long-random-string（启动守卫拒绝）
#   ✅ DEEPSEEK_API_KEY / TONGYI_API_KEY 不能是公共测试 Key
#   ❌ 永远不要将 .env 提交到 Git
#   ❌ 永远不要在前端代码中引用这些值

# --- 运行环境 ---
# 生产必设 production：DATABASE_URL 默认 changeme 守卫（fail-fast）的生效前提
ENVIRONMENT=production

# --- PostgreSQL（Docker Compose 自动加载）---
# 占位 changeme 必须替换。已有 postgres_data 卷时：改本文件 ≠ 自动改库内密码；
# 须 ALTER USER 对齐，或删卷重建（清空数据，先备份）。详见 DEPLOY §3.2 / M11-B1。
POSTGRES_PASSWORD=changeme
# api 容器内由 docker-compose.yml 覆盖为 postgres 主机名；本机 venv 连 Docker 库时用 localhost：
DATABASE_URL=postgresql+asyncpg://ruige:${POSTGRES_PASSWORD:-changeme}@localhost:5432/ruige

# --- 监控（Grafana 管理密码，T6-DC-2 弱口令守卫）---
# 必须替换为 ≥ 32 位随机字符；compose 未配置该变量会 fail-fast 拒绝启动
GRAFANA_PASSWORD=changeme

# --- JWT 鉴权（生产必须改为长随机串）---
JWT_SECRET=changeme

# --- Webhook 回调安全 ---
# P1-S2：webhook secret 的 at-rest 加密专用密钥（独立管理，禁止与 JWT_SECRET 相同）
WEBHOOK_ENCRYPTION_SECRET=changeme

# --- LLM / 嵌入 API Key（仅服务端读取）---
# 对话：CHAT_PROVIDER=deepseek|tongyi（默认 deepseek；通义复用 TONGYI_API_KEY，不做设置页 UI）
CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
TONGYI_API_KEY=
TONGYI_BASE_URL=https://dashscope.aliyuncs.com
# TONGYI_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TONGYI_CHAT_MODEL=qwen-plus
# 嵌入：默认 bge = BGE-small-zh 本地 ONNX（零云依赖，无需 Key）；tongyi 为可切换备选（须配 TONGYI_API_KEY）
EMBEDDING_PROVIDER=bge
# EMBEDDING_MODEL=text-embedding-v2   # 仅当 EMBEDDING_PROVIDER=tongyi 时生效
RE_EMBED_TOKEN=
ORPHAN_SCAN_TOKEN=
# ORPHAN_GRACE_HOURS=24
# ORPHAN_MAX_DELETE=100
# TRASH_RETENTION_DAYS=30
# TRASH_PURGE_MAX_DELETE=100
# NW-20 对话保留期（0=禁用；CLI scripts/purge_chat_threads.py；默认干跑；先备后 purge）
# CHAT_RETENTION_DAYS=0
# CHAT_PURGE_MAX_DELETE=100
# NW-12 stale ingestion CLI（默认干跑；--apply 须 CELERY_TASK_ALWAYS_EAGER_LOCAL=false）
# INGEST_STALE_QUEUED_MINUTES=60
# INGEST_STALE_PROCESSING_MINUTES=120
# INGEST_STALE_MAX_APPLY=100

# --- 检索融合 / 拒答（A4：默认已复核；勿盲改）---
# RRF_K=60
# RRF_VECTOR_WEIGHT=1.0
RRF_FTS_WEIGHT=1.5
# RETRIEVAL_MIN_TOP1_SIMILARITY=0.35
# RELEVANCE_SIMILARITY_FALLBACK=0.45

# --- Rerank（A2：BGE ONNX 真路径；默认关，按 diagnose 决定是否开）---
RERANK_ENABLED=false
# off=默认 RRF；always=旧开精排+高置信跳过；conditional=仅排序歧义时精排
RERANK_POLICY=off
RERANK_PROVIDER=bge
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_INPUT_TOP_N=20
# BGE_RERANK_CACHE_DIR=

# --- A1 多 query（默认单问；生产勿 always）---
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_POLICY=off

# --- Celery 异步入库（G1：生产须非 eager；compose 已对 api/worker 设 false）---
# 正确变量名须带 _LOCAL；写 CELERY_TASK_ALWAYS_EAGER 无效
CELERY_TASK_ALWAYS_EAGER_LOCAL=false
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# 回滚堵 API 路径：改为 true 并重启 api（worker 可停）

# --- Redis 跨副本限流（G2）---
# 限流/缓存用 DB1；Celery 用 DB0。代码默认已是 redis，此处显式声明保持一致；回滚：RATE_LIMIT_BACKEND=memory 并重启 api
REDIS_URL=redis://redis:6379/1
RATE_LIMIT_BACKEND=redis

# --- 文件存储 ---
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=20971520
# NW-25 单库总容量硬闸（含 trash + 版本；非计费）。默认 10GiB；0=关闭
KB_QUOTA_MAX_BYTES=10737418240

# --- 引用 excerpt 脱敏（NW-27：默认开；演示真号可关）---
# CITATION_REDACT_ENABLED=true
# NW-34 送模片段 scrub（P2-R16 默认开；关须接受明文出境风险；仍算出境）
# LLM_CONTEXT_REDACT_ENABLED=true

# --- PDF 文字层版式降噪（B1：默认开；异常时可关）---
# PDF_LAYOUT_DENOISE_ENABLED=true

# --- 大表 / 跨页表格（B2：默认开；异常时可关≈F3）---
# TABLE_CHUNK_SPLIT_ENABLED=true
# TABLE_PARENT_MAX_CHARS=8000
# TABLE_ROW_OVERLAP=1

# --- 前端跨域（生产改为实际域名/IP）---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SMTP 邮件（密码重置用）---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# FORGOT_PASSWORD_FROM_EMAIL=noreply@ruige.app
# FORGOT_PASSWORD_RESET_URL=http://localhost:5173/reset-password

# --- 弹性配置（可覆盖默认值）---
# LLM_TIMEOUT_SECONDS=120.0
# RETRY_MAX_ATTEMPTS=2
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# DEGRADATION_COOLDOWN_SECONDS=60
# HTTP_MAX_CONNECTIONS=10
